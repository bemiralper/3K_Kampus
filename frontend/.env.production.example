# Sunucuda frontend/.env.production.local olarak kopyalayın
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=https://www.3kkampus.com

# Meta Open Graph fb:app_id yedek (asıl kaynak: İletişim → WhatsApp Hesapları → Meta App ID)
# NEXT_PUBLIC_FACEBOOK_APP_ID=123456789012345

# Meta Business domain verification — doğrulama sonrası kaldırmak için "off" yazın veya satırı silin
# NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=rzjoujm3azogd4hc17sr0l3x3s2ofo
# NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=off
